@Article{Collett2009,
  Title                    = {A Power-Control Theory of Gender and Religiosity},
  Author                   = {Collett, Jessica L. and Lizardo, Omar},
  Journal                  = {Journal for the Scientific Study of Religion},
  Year                     = {2009},
  Number                   = {2},
  Pages                    = {pp. 213-231},
  Volume                   = {48},

  __markedentry            = {[olizardo:6]},
  Abstract                 = {The fact that women are more religious than men is one of the most consistent findings in the sociology of religion. Miller and Stark (2002) propose that a gender difference in risk preference of physiological origin might explain this phenomenon. While acknowledging the utility of their risk-preference mechanism, we believe that their assumption regarding the genesis of this difference is a premature concession to biology. Returning to Miller's original paper on gender, risk, and religiosity, we draw on power-control theory (PCT), developed in the work of John Hagan and colleagues, to introduce a plausible socialization account for these differences. We evaluate these claims using data from the General Social Survey. Women raised by high-socioeconomic status (SES) mothers are less religious than women raised by low-education mothers, but mother's SES has little effect on men's chances of being irreligious and father's SES has a negligible effect on the gender difference in religiosity.},
  Copyright                = {Copyright © 2009 Society for the Scientific Study of Religion},
  ISSN                     = {00218294},
  Jstor_articletype        = {research-article},
  Jstor_formatteddate      = {Jun., 2009},
  Language                 = {English},
  Owner                    = {olizardo},
  Publisher                = {Wiley-Blackwell on behalf of Society for the Scientific Study of Religion},
  Timestamp                = {2012.08.29},
  Url                      = {http://www.jstor.org/stable/40405611}
}

